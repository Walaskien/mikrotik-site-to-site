# RouterOS 7 configuration for site "{{ site.name }}", generated by s2s from the input YAML.
# Review before applying. Take /system backup first. Peer public keys come from the input;
# this router's own public keys are shown by: /interface/wireguard print
/system identity set name={{ site.name }}

# --- interface lists ---------------------------------------------------------
/interface list
add name=WAN
add name=LAN
add name=TUNNEL
/interface list member
add list=LAN interface={{ site.lan_if }}
add list=WAN interface={{ site.wan_raw.interface }}
{% if has_backup %}
add list=WAN interface={{ site.backup_raw.interface }}
{% endif %}
add list=TUNNEL interface=wg-primary
{% if has_backup %}
add list=TUNNEL interface=wg-backup
{% endif %}

# --- addresses ---------------------------------------------------------------
/ip address
add address={{ site.lan }} interface={{ site.lan_if }} comment="LAN"
add address={{ site.wan }} interface={{ site.wan_raw.interface }} comment="WAN primary"
{% if has_backup %}
add address={{ site.backup }} interface={{ site.backup_raw.interface }} comment="WAN backup"
{% endif %}

# --- WireGuard tunnels (private keys are generated on the router, never stored here) ---
/interface wireguard
add name=wg-primary listen-port={{ t.primary_port }} mtu={{ t.mtu }}
{% if has_backup %}
add name=wg-backup listen-port={{ t.backup_port }} mtu={{ t.mtu }}
{% endif %}
/ip address
add address={{ primary_ip }} interface=wg-primary comment="tunnel primary"
{% if has_backup %}
add address={{ backup_ip }} interface=wg-backup comment="tunnel backup"
{% endif %}
/interface wireguard peers
{% for p in peers %}
add interface=wg-primary name={{ p.name }}-primary public-key="{{ p.primary.key }}" endpoint-address={{ p.primary.endpoint }} endpoint-port={{ t.primary_port }} allowed-address={{ p.primary.tunnel_ip }}/32,{{ p.lan }} persistent-keepalive=25s
{% if p.backup %}
add interface=wg-backup name={{ p.name }}-backup public-key="{{ p.backup.key }}" endpoint-address={{ p.backup.endpoint }} endpoint-port={{ t.backup_port }} allowed-address={{ p.backup.tunnel_ip }}/32,{{ p.lan }} persistent-keepalive=25s
{% endif %}
{% endfor %}

# --- routing -----------------------------------------------------------------
# Default routes: primary WAN preferred, backup WAN used when the primary gateway stops answering ping.
/ip route
add dst-address=0.0.0.0/0 gateway={{ site.wan_raw.gateway }} distance=1 check-gateway=ping comment="default primary"
{% if has_backup %}
add dst-address=0.0.0.0/0 gateway={{ site.backup_raw.gateway }} distance=2 check-gateway=ping comment="default backup"
{% endif %}
# Pin each tunnel endpoint to its own WAN so tunnel packets never ride the other link.
{% for p in peers %}
add dst-address={{ p.primary.endpoint }}/32 gateway={{ site.wan_raw.gateway }} distance=1 comment="{{ p.name }} endpoint via primary WAN"
{% if p.backup %}
add dst-address={{ p.backup.endpoint }}/32 gateway={{ site.backup_raw.gateway }} distance=1 comment="{{ p.name }} endpoint via backup WAN"
{% endif %}
{% endfor %}
# Remote LANs: primary tunnel (distance 1), backup tunnel (distance 5). check-gateway pings the far tunnel address.
{% for p in peers %}
add dst-address={{ p.lan }} gateway={{ p.primary.tunnel_ip }} distance=1 check-gateway=ping comment="{{ p.name }} LAN via primary tunnel"
{% if p.backup %}
add dst-address={{ p.lan }} gateway={{ p.backup.tunnel_ip }} distance=5 check-gateway=ping comment="{{ p.name }} LAN via backup tunnel"
{% endif %}
{% endfor %}

# --- address lists -----------------------------------------------------------
/ip firewall address-list
{% for lan in peer_lans %}
add list=s2s-lans address={{ lan }}
{% endfor %}
{% for p in peers %}
add list=s2s-peers address={{ p.primary.endpoint }}
{% if p.backup %}
add list=s2s-peers address={{ p.backup.endpoint }}
{% endif %}
{% endfor %}
{% for m in mgmt %}
add list=mgmt address={{ m }}
{% endfor %}

# --- firewall: order matters, rules are evaluated top to bottom ---------------
/ip firewall filter
add chain=input action=accept connection-state=established,related,untracked comment="input: established"
add chain=input action=drop connection-state=invalid comment="input: invalid"
add chain=input action=accept protocol=icmp comment="input: ping"
add chain=input action=accept in-interface-list=LAN comment="input: own LAN"
add chain=input action=accept protocol=udp dst-port={{ t.primary_port }}{% if has_backup %},{{ t.backup_port }}{% endif %} src-address-list=s2s-peers in-interface-list=WAN comment="input: WireGuard from known peers"
add chain=input action=accept protocol=tcp dst-port=22,8291 src-address-list=mgmt comment="input: SSH/Winbox from management networks"
add chain=input action=drop in-interface-list=!LAN comment="input: drop the rest"
add chain=forward action=accept connection-state=established,related,untracked comment="forward: established"
add chain=forward action=drop connection-state=invalid comment="forward: invalid"
add chain=forward action=accept in-interface-list=LAN out-interface-list=TUNNEL dst-address-list=s2s-lans comment="forward: LAN to remote LANs"
add chain=forward action=accept in-interface-list=TUNNEL out-interface-list=LAN src-address-list=s2s-lans comment="forward: remote LANs to LAN"
add chain=forward action=drop in-interface-list=LAN out-interface-list=WAN dst-address-list=s2s-lans comment="forward: never leak remote-LAN traffic to the Internet"
add chain=forward action=accept in-interface-list=LAN out-interface-list=WAN comment="forward: LAN to Internet"
add chain=forward action=accept connection-nat-state=dstnat comment="forward: allow port forwards"
add chain=forward action=drop comment="forward: drop the rest"

# --- NAT and MSS ----------------------------------------------------------------
# Tunnel traffic leaves through wg-* interfaces, not WAN, so this rule does not touch it.
/ip firewall nat
add chain=srcnat action=masquerade out-interface-list=WAN comment="Internet access"
/ip firewall mangle
add chain=forward action=change-mss new-mss=clamp-to-pmtu passthrough=yes protocol=tcp tcp-flags=syn out-interface-list=TUNNEL comment="MSS clamp for tunnels"
