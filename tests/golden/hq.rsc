# RouterOS 7 configuration for site "hq", generated by s2s from the input YAML.
# Review before applying. Take /system backup first. Peer public keys come from the input;
# this router's own public keys are shown by: /interface/wireguard print
/system identity set name=hq

# --- interface lists ---------------------------------------------------------
/interface list
add name=WAN
add name=LAN
add name=TUNNEL
/interface list member
add list=LAN interface=bridge-lan
add list=WAN interface=ether1
add list=WAN interface=ether2
add list=TUNNEL interface=wg-primary
add list=TUNNEL interface=wg-backup

# --- addresses ---------------------------------------------------------------
/ip address
add address=10.10.0.1/24 interface=bridge-lan comment="LAN"
add address=203.0.113.2/30 interface=ether1 comment="WAN primary"
add address=198.51.100.2/30 interface=ether2 comment="WAN backup"

# --- WireGuard tunnels (private keys are generated on the router, never stored here) ---
/interface wireguard
add name=wg-primary listen-port=13231 mtu=1420
add name=wg-backup listen-port=13232 mtu=1420
/ip address
add address=10.255.1.1/24 interface=wg-primary comment="tunnel primary"
add address=10.255.2.1/24 interface=wg-backup comment="tunnel backup"
/interface wireguard peers
add interface=wg-primary name=branch1-primary public-key="ZXhhbXBsZS1wdWJsaWMta2V5LWJyMS1wcmltYXJ5LTA=" endpoint-address=203.0.113.6 endpoint-port=13231 allowed-address=10.255.1.2/32,10.20.0.0/24 persistent-keepalive=25s
add interface=wg-backup name=branch1-backup public-key="ZXhhbXBsZS1wdWJsaWMta2V5LWJyMS1iYWNrdXAtMDA=" endpoint-address=198.51.100.6 endpoint-port=13232 allowed-address=10.255.2.2/32,10.20.0.0/24 persistent-keepalive=25s
add interface=wg-primary name=branch2-primary public-key="ZXhhbXBsZS1wdWJsaWMta2V5LWJyMi1wcmltYXJ5LTA=" endpoint-address=203.0.113.10 endpoint-port=13231 allowed-address=10.255.1.3/32,10.30.0.0/24 persistent-keepalive=25s

# --- routing -----------------------------------------------------------------
# Default routes: primary WAN preferred, backup WAN used when the primary gateway stops answering ping.
/ip route
add dst-address=0.0.0.0/0 gateway=203.0.113.1 distance=1 check-gateway=ping comment="default primary"
add dst-address=0.0.0.0/0 gateway=198.51.100.1 distance=2 check-gateway=ping comment="default backup"
# Pin each tunnel endpoint to its own WAN so tunnel packets never ride the other link.
add dst-address=203.0.113.6/32 gateway=203.0.113.1 distance=1 comment="branch1 endpoint via primary WAN"
add dst-address=198.51.100.6/32 gateway=198.51.100.1 distance=1 comment="branch1 endpoint via backup WAN"
add dst-address=203.0.113.10/32 gateway=203.0.113.1 distance=1 comment="branch2 endpoint via primary WAN"
# Remote LANs: primary tunnel (distance 1), backup tunnel (distance 5). check-gateway pings the far tunnel address.
add dst-address=10.20.0.0/24 gateway=10.255.1.2 distance=1 check-gateway=ping comment="branch1 LAN via primary tunnel"
add dst-address=10.20.0.0/24 gateway=10.255.2.2 distance=5 check-gateway=ping comment="branch1 LAN via backup tunnel"
add dst-address=10.30.0.0/24 gateway=10.255.1.3 distance=1 check-gateway=ping comment="branch2 LAN via primary tunnel"

# --- address lists -----------------------------------------------------------
/ip firewall address-list
add list=s2s-lans address=10.20.0.0/24
add list=s2s-lans address=10.30.0.0/24
add list=s2s-peers address=203.0.113.6
add list=s2s-peers address=198.51.100.6
add list=s2s-peers address=203.0.113.10
add list=mgmt address=192.0.2.0/24

# --- firewall: order matters, rules are evaluated top to bottom ---------------
/ip firewall filter
add chain=input action=accept connection-state=established,related,untracked comment="input: established"
add chain=input action=drop connection-state=invalid comment="input: invalid"
add chain=input action=accept protocol=icmp comment="input: ping"
add chain=input action=accept in-interface-list=LAN comment="input: own LAN"
add chain=input action=accept protocol=udp dst-port=13231,13232 src-address-list=s2s-peers in-interface-list=WAN comment="input: WireGuard from known peers"
add chain=input action=accept protocol=tcp dst-port=22,8291 src-address-list=mgmt comment="input: SSH/Winbox from management networks"
add chain=input action=drop in-interface-list=!LAN comment="input: drop the rest"
add chain=forward action=accept connection-state=established,related,untracked comment="forward: established"
add chain=forward action=drop connection-state=invalid comment="forward: invalid"
add chain=forward action=accept in-interface-list=LAN out-interface-list=TUNNEL dst-address-list=s2s-lans comment="forward: LAN to remote LANs"
add chain=forward action=accept in-interface-list=TUNNEL out-interface-list=LAN src-address-list=s2s-lans comment="forward: remote LANs to LAN"
add chain=forward action=drop in-interface-list=LAN out-interface-list=WAN dst-address-list=s2s-lans comment="forward: never leak remote-LAN traffic to the Internet"
add chain=forward action=accept in-interface-list=LAN out-interface-list=WAN comment="forward: LAN to Internet"
add chain=forward action=accept connection-nat-state=dstnat comment="forward: allow port forwards"
add chain=forward action=drop comment="forward: drop the rest"

# --- NAT and MSS ----------------------------------------------------------------
# Tunnel traffic leaves through wg-* interfaces, not WAN, so this rule does not touch it.
/ip firewall nat
add chain=srcnat action=masquerade out-interface-list=WAN comment="Internet access"
/ip firewall mangle
add chain=forward action=change-mss new-mss=clamp-to-pmtu passthrough=yes protocol=tcp tcp-flags=syn out-interface-list=TUNNEL comment="MSS clamp for tunnels"
